# 애플리케이션 설정
APP_NAME=fastapi-app
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fastapi-app
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi-app

# Redis 설정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ 설정
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=rabbit
RABBITMQ_VHOST=/

# 서버 설정
HOST=0.0.0.0
PORT=8000 